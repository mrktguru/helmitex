# /portal_helmitex/.env — chmod 600, только на сервере
POSTGRES_DB=labelstudio
POSTGRES_USER=labelstudio
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://labelstudio:<POSTGRES_PASSWORD>@postgres:5432/labelstudio

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=labelstudio
S3_REGION=eu-central-1
S3_ACCESS_KEY=<MINIO_ROOT_USER>
S3_SECRET_KEY=<MINIO_ROOT_PASSWORD>

JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=https://portal.helmitex.ru
PORT=3100
NODE_ENV=production

# Ozon Seller API (FBO-поставки)
OZON_CLIENT_ID=
OZON_API_KEY=
