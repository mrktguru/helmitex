generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  login        String?       @unique
  passwordHash String
  role         Role          @default(OPERATOR)
  createdAt    DateTime      @default(now())
  projects     Project[]
  stockDocs    StockDoc[]
  fboShipments FboShipment[]
}

enum Role {
  ADMIN
  OPERATOR
}

model Project {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  template      LabelTemplate?
  czBatches     CzBatch[]
  outputBatches OutputBatch[]
  quantTypes    QuantType[]
  czSpecs       ProductSpec[]  @relation("SpecCzProject")
}

model LabelTemplate {
  id           String   @id @default(uuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id])
  widthMm      Float
  heightMm     Float
  elements     Json // array of LabelElement objects
  czArea       Json // { xMm, yMm, widthMm, heightMm }
  barcodeValue String?
  printMargins Json? // { topMm, rightMm, bottomMm, leftMm }
  variables    Json? // { [token: string]: string } — current values
  variableDefs Json? // [{ token: string, name: string }] — declared variables
  updatedAt    DateTime @updatedAt
}

model CzBatch {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  s3Key      String
  totalCount Int
  fileHash   String?
  uploadedAt DateTime @default(now())
  codes      CzCode[]

  @@unique([projectId, fileHash])
}

model CzCode {
  id            String       @id @default(uuid())
  czBatchId     String
  czBatch       CzBatch      @relation(fields: [czBatchId], references: [id])
  pageIndex     Int
  code          String?
  status        CodeStatus   @default(PENDING)
  usedAt        DateTime?
  outputBatchId String?
  outputBatch   OutputBatch? @relation(fields: [outputBatchId], references: [id])
  quantCodes    QuantCode[]
  wbOrder       WbOrder?
}

enum CodeStatus {
  PENDING
  USED
  SPOILED // этикетка испорчена, код выведен из кванта
}

model OutputBatch {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  s3Key     String   @default("")
  jobStatus String   @default("pending")
  fromIndex Int
  toIndex   Int
  count     Int
  createdAt DateTime @default(now())
  codes     CzCode[]
  quant     Quant?
  lotId     String? // партия ГП, для которой печатались этикетки
  docId     String? // документ маркировки (MARK)
  variables Json? // значения переменных макета на этот тираж: { lot, expiry }

  @@index([lotId])
  @@index([docId])
}

// ─────────────────────────── Склад ───────────────────────────

enum ItemType {
  RAW // сырьё, кг
  CONTAINER // тара: тубы, банки, вёдра
  PACKAGING // короба
  LABEL // этикетки, наклейки
  SEMI // полуфабрикат (бочки)
  PRODUCT // готовая продукция (SKU)
}

enum ProductState {
  NONE // для всего, кроме ГП
  UNLABELED // расфасовано, без ЧЗ
  LABELED // оклеено ЧЗ, россыпью
  IN_QUANT // уложено в квант
}

model Item {
  id          String              @id @default(uuid())
  type        ItemType // категория: сырьё, тара, упаковка, этикетки, полуфабрикаты, готовая продукция
  kind        String? // тип внутри категории (свободный): «Биоцид», «Загуститель», для коробов — размер, для ГП — «Шпатлёвка»
  name        String
  unit        String // "кг" | "шт" | "л"
  minStock    Float?
  noStock     Boolean             @default(false) // не учитывается на складе (вода)
  archived    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  lots        Lot[]
  docLines    StockDocLine[]
  recipeId    String? // полуфабрикат: рецептура из справочника «Рецептуры»
  recipe      Recipe?             @relation("ItemRecipe", fields: [recipeId], references: [id])
  recipeLines RecipeLine[]
  outputDocs  StockDoc[]          @relation("DocOutputItem")
  spec        ProductSpec?        @relation("SpecProduct")
  specsAsSemi ProductSpec[]       @relation("SpecSemi")
  materialOf  ProductMaterial[]   @relation("MaterialItem")
  quantTypes  QuantType[]         @relation("QuantProduct")
  quantBoxes  QuantType[]         @relation("QuantBox")
  quantMats   QuantTypeMaterial[]

  @@unique([type, name])
}

model Lot {
  id          String      @id @default(uuid())
  number      String      @unique // С-1007-01, П-1007-01, Г-1007-01
  itemId      String
  item        Item        @relation(fields: [itemId], references: [id])
  supplierLot String?
  expiresAt   DateTime?
  unitCost    Float? // ₽ за единицу учёта, null = не задана
  barrel      String? // номер бочки для полуфабриката
  parentLotId String? // для ГП — бочка, из которой фасовали
  createdAt   DateTime    @default(now())
  moves       StockMove[]
  quants      Quant[]

  @@index([itemId])
}

enum DocType {
  RECEIPT // приход
  OPENING // ввод начальных остатков
  ADJUSTMENT // корректировка / инвентаризация
  MIX // замес полуфабриката
  FILL // фасовка
  QUANT // сборка квантов
  SHIPMENT // отгрузка (FBO)
  MARK // маркировка: печать ЧЗ на партию, «без ЧЗ» → «с ЧЗ»
}

enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
}

model StockDoc {
  id        String         @id @default(uuid())
  number    String         @unique
  type      DocType
  status    DocStatus      @default(DRAFT)
  date      DateTime       @default(now())
  supplier  String?
  docRef    String? // УПД № 4417 от 06.10
  comment   String?
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  postedAt  DateTime?
  createdAt DateTime       @default(now())
  lines     StockDocLine[]
  moves     StockMove[]

  // замес: что получаем
  outputItemId String?
  outputItem   Item?         @relation("DocOutputItem", fields: [outputItemId], references: [id])
  outputLotId  String?
  plannedQty   Float?
  yieldQty     Float?
  barrel       String?
  expiresAt    DateTime?
  sourceLotId  String? // фасовка: бочка
  remainQty    Float? // фасовка: остаток в бочке после фасовки (null — бочку не закрывать)
  quantTypeId  String?
  quantType    QuantType?    @relation(fields: [quantTypeId], references: [id])
  quantCount   Int?
  sourceState  ProductState? // сборка квантов: из «без ЧЗ» или «с ЧЗ»
  imported     Boolean       @default(false) // ввод существующих квантов
  quants       Quant[]
}

model StockDocLine {
  id          String       @id @default(uuid())
  docId       String
  doc         StockDoc     @relation(fields: [docId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item         @relation(fields: [itemId], references: [id])
  lotId       String? // для корректировки — существующий лот; для прихода заполняется при проведении
  qty         Float // для прихода > 0; для корректировки — со знаком
  planQty     Float? // замес: норма по рецептуре (null — корректировка сверх рецептуры)
  stage       Int? // замес: этап
  sort        Int          @default(0)
  unitCost    Float?
  supplierLot String?
  expiresAt   DateTime?
  barrel      String?
  state       ProductState @default(NONE)
  reason      String?
}

model StockMove {
  id        String       @id @default(uuid())
  docId     String
  doc       StockDoc     @relation(fields: [docId], references: [id])
  lotId     String
  lot       Lot          @relation(fields: [lotId], references: [id])
  state     ProductState @default(NONE)
  qty       Float // + приход, − расход
  createdAt DateTime     @default(now())

  @@index([lotId, state])
}

model Recipe {
  id        String       @id @default(uuid())
  name      String       @unique
  items     Item[]       @relation("ItemRecipe") // полуфабрикаты, которые замешиваются по этой рецептуре
  stages    Json? // { "1": "Вода и диспергаторы · мин. обороты, 3 мин", … }
  qc        String? // нормы ОТК текстом
  comment   String?
  updatedAt DateTime     @updatedAt
  lines     RecipeLine[]
}

model RecipeLine {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
  percent  Float
  stage    Int    @default(1)
  sort     Int    @default(0)
}

// Карточка SKU готовой продукции: из чего и как фасуется
model ProductSpec {
  id              String            @id @default(uuid())
  itemId          String            @unique
  item            Item              @relation("SpecProduct", fields: [itemId], references: [id])
  semiItemId      String?
  semiItem        Item?             @relation("SpecSemi", fields: [semiItemId], references: [id])
  netQty          Float? // кг полуфабриката в 1 шт
  ozonOfferId     String? // артикул в Ozon
  ozonSku         String? // SKU Ozon (из /v3/product/info/list)
  ozonName        String?
  wbArticle       String?           @unique // артикул продавца в WB (в заданиях FBS — поле article)
  gtin            String?           @unique // GTIN в кодах ЧЗ (01 + 14 цифр) — по нему загруженные коды раскладываются по SKU
  shelfLifeMonths Int? // срок годности ГП от даты фасовки
  requiresCz      Boolean           @default(false) // обязательна маркировка Честный знак
  czProjectId     String? // проект портала с макетом этикетки ЧЗ
  czProject       Project?          @relation("SpecCzProject", fields: [czProjectId], references: [id])
  updatedAt       DateTime          @updatedAt
  materials       ProductMaterial[]
}

model ProductMaterial {
  id         String      @id @default(uuid())
  specId     String
  spec       ProductSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item        @relation("MaterialItem", fields: [itemId], references: [id])
  qtyPerUnit Float       @default(1)
  sort       Int         @default(0)
}

// Тип кванта: сколько единиц какого SKU в какой короб и с какими этикетками
model QuantType {
  id            String              @id @default(uuid())
  name          String              @unique
  productItemId String
  productItem   Item                @relation("QuantProduct", fields: [productItemId], references: [id])
  unitsPerQuant Int
  boxItemId     String?
  boxItem       Item?               @relation("QuantBox", fields: [boxItemId], references: [id])
  trackCz       Boolean             @default(true)
  projectId     String? // проект портала с макетом этикетки ЧЗ
  project       Project?            @relation(fields: [projectId], references: [id])
  labelWidthMm  Float               @default(58)
  labelHeightMm Float               @default(40)
  archived      Boolean             @default(false)
  createdAt     DateTime            @default(now())
  materials     QuantTypeMaterial[]
  quants        Quant[]
  docs          StockDoc[]
  fbsBatches    OzonFbsBatch[]
}

model QuantTypeMaterial {
  id          String    @id @default(uuid())
  quantTypeId String
  quantType   QuantType @relation(fields: [quantTypeId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  qtyPerQuant Float
  sort        Int       @default(0)
}

enum QuantStatus {
  ASSEMBLED // собран, на складе
  RESERVED // в поставке
  SHIPPED // отгружен
  DISASSEMBLED // разобран / отменён
}

model Quant {
  id            String       @id @default(uuid())
  number        String       @unique // К-261008-001
  quantTypeId   String
  quantType     QuantType    @relation(fields: [quantTypeId], references: [id])
  lotId         String
  lot           Lot          @relation(fields: [lotId], references: [id])
  docId         String
  doc           StockDoc     @relation(fields: [docId], references: [id])
  units         Int
  status        QuantStatus  @default(ASSEMBLED)
  unitCost      Float? // себестоимость кванта целиком
  outputBatchId String?      @unique
  outputBatch   OutputBatch? @relation(fields: [outputBatchId], references: [id])
  createdAt     DateTime     @default(now())
  codes         QuantCode[]
  fboCargoes    FboCargo[]

  @@index([status, quantTypeId])
}

// Коды ЧЗ, лежащие в кванте. Замена испорченной этикетки: старая строка active=false, новая — active=true.
model QuantCode {
  id        String   @id @default(uuid())
  quantId   String
  quant     Quant    @relation(fields: [quantId], references: [id], onDelete: Cascade)
  czCodeId  String?
  czCode    CzCode?  @relation(fields: [czCodeId], references: [id])
  code      String? // текст кода; для введённых вручную — единственный источник
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([czCodeId])
  @@index([code])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum FboStatus {
  DRAFT // кванты подобраны и зарезервированы
  OZON_DRAFT // черновик в Ozon создан, склады рассчитаны
  BOOKED // заявка создана, слот забронирован
  CARGOES_SET // грузоместа переданы
  LABELS_READY // этикетки грузомест получены
  SHIPPED // отгружено, кванты списаны
  COMPLETED // принято Ozon
  CANCELLED
}

model FboShipment {
  id                 String     @id @default(uuid())
  number             String     @unique // ПС-261008-01
  status             FboStatus  @default(DRAFT)
  supplyType         String     @default("CROSSDOCK") // CROSSDOCK | DIRECT
  clusterId          String?
  clusterName        String?
  dropOffWarehouseId String?
  dropOffName        String?
  dropOffType        String?
  storageWarehouseId String?
  storageName        String?
  ozonDraftId        String?
  draftCreatedAt     DateTime?
  draftWarehouses    Json? // ответ /v2/draft/create/info: склады кластера
  ozonOrderId        String?
  ozonOrderNumber    String?
  ozonSupplyId       String?
  ozonState          String?
  ozonStateAt        DateTime?
  timeslotFrom       String? // время склада, как отдаёт Ozon
  timeslotTo         String?
  labelS3Key         String?
  lastError          String?
  stockDocId         String?
  comment            String?
  userId             String
  user               User       @relation(fields: [userId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  shippedAt          DateTime?
  cargoes            FboCargo[]
}

model FboCargo {
  id          String      @id @default(uuid())
  shipmentId  String
  shipment    FboShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  quantId     String
  quant       Quant       @relation(fields: [quantId], references: [id])
  ozonCargoId String?
  sort        Int         @default(0)

  @@unique([shipmentId, quantId])
}

// ─────────────────────────── Аналитика рекламы ───────────────────────────

// Воронка и финансы SKU за день: Seller API (analytics/data) + начисления (finance/accrual/by-day)
model AdDaySku {
  date        DateTime @db.Date
  sku         String
  views       Int      @default(0) // показы всего
  searchViews Int      @default(0)
  pdpViews    Int      @default(0) // просмотры карточки
  toCart      Int      @default(0)
  orders      Int      @default(0) // заказано, шт
  revenue     Float    @default(0) // заказано, ₽
  position    Float? // средняя позиция в категории
  // Начисления за день (по дате начисления, не заказа)
  accrQty     Int      @default(0)
  accrSale    Float    @default(0) // по цене продавца
  accrBuyer   Float    @default(0) // оплатил покупатель
  accrPayout  Float    @default(0) // к выплате: продажа − комиссия − логистика − сборы
  updatedAt   DateTime @updatedAt

  @@id([date, sku])
}

// Реклама с оплатой за клик: кампания × SKU × день (Performance API statistics)
model AdDayCampaign {
  date        DateTime @db.Date
  campaignId  String
  sku         String
  views       Int      @default(0)
  clicks      Int      @default(0)
  toCart      Int      @default(0)
  orders      Int      @default(0)
  ordersMoney Float    @default(0)
  spend       Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@id([date, campaignId, sku])
}

// Списания по кампании за день из начислений (оплата за заказ — только так видна реальная сумма)
model AdDayCharge {
  date       DateTime @db.Date
  campaignId String
  kind       String // ORDER | CLICK
  amount     Float
  updatedAt  DateTime @updatedAt

  @@id([date, campaignId, kind])
}

// Какие дни уже загружены (чтобы не перезапрашивать дни без данных)
model AdSyncDay {
  kind      String // seller | perf | finance
  date      DateTime @db.Date
  fetchedAt DateTime @default(now())

  @@id([kind, date])
}

// Снимок рекламы каждые 30 минут: накопленные за текущий день (МСК) показатели кампании.
// Разница между соседними снимками даёт статистику по получасам — Ozon по часам её не отдаёт.
model AdIntraday {
  at           DateTime // момент снимка
  day          DateTime @db.Date // день по Москве
  campaignId   String
  views        Int
  clicks       Int
  toCart       Int
  orders       Int
  ordersMoney  Float
  spend        Float
  state        String
  weeklyBudget Float    @default(0)
  dailyBudget  Float    @default(0)
  bids         Json? // { sku: ставка ₽ }

  @@id([at, campaignId])
  @@index([campaignId, day])
}

// Биддер кампании: цель + модификаторы + ограничители. Решения — каждые 30 минут после снимка
model AdBidder {
  campaignId String   @id
  enabled    Boolean  @default(false)
  goal       String   @default("CART") // CART — цена корзины с поправкой на конверсию в заказ | ORDER | DRR
  targetCpo  Float    @default(220) // целевая цена заказа, ₽
  targetDrr  Float    @default(0.25)
  mods       Json // { hours, pace, stock, elastic, organic, budgetUp }
  limits     Json // { minBid, maxBid, maxStepPct, cooldownMin, minClicks, maxChangesPerDay, stopLossRub, hourFrom, hourTo }
  state      Json? // базовая ставка, время последнего изменения, проверка отклика показов и т. п.
  updatedBy  String?
  updatedAt  DateTime @updatedAt
}

model AdBidderLog {
  id         String   @id @default(uuid())
  campaignId String
  at         DateTime @default(now())
  action     String // BID_UP | BID_DOWN | BUDGET_UP | HOLD | FREEZE | REVERT | STOCK | ERROR
  fromValue  Float?
  toValue    Float?
  reason     String
  metrics    Json?

  @@index([campaignId, at])
}

// Журнал изменений: вручную и автоматически при действиях из сервиса
model AdJournal {
  id         String   @id @default(uuid())
  sku        String?
  campaignId String?
  at         DateTime // когда сделали изменение
  kind       String // PRICE | ACTION_PRICE | BID | BUDGET | CAMPAIGN_ON | CAMPAIGN_OFF | CAMPAIGN_NEW | CPO_ON | CPO_OFF | CPO_BID | PROMO | NOTE
  text       String
  source     String   @default("MANUAL") // MANUAL | AUTO
  meta       Json?
  userEmail  String?
  createdAt  DateTime @default(now())

  @@index([sku, at])
}

model OzonApiLog {
  id         String   @id @default(uuid())
  shipmentId String?
  method     String
  status     Int
  request    Json?
  response   Json?
  ms         Int
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

// ─────────────────────────── WB FBS ───────────────────────────

// Поставка FBS в WB (кэш + локальное состояние сборки)
model WbSupply {
  id              String    @id // WB-GI-…
  name            String
  createdAt       DateTime
  done            Boolean   @default(false)
  closedAt        DateTime?
  cargoType       Int?
  shippingType    String?
  shippingPointId Int?
  shippingDt      String?
  stockDocId      String? // списание со склада при передаче в доставку
  stickerError    String? // WB не отдал стикеры заданий — номера берутся из листа подбора
  syncedAt        DateTime  @default(now())
  orders          WbOrder[]
}

// Сборочное задание WB FBS (одна единица товара)
model WbOrder {
  id              String    @id // orderId WB
  supplyId        String?
  supply          WbSupply? @relation(fields: [supplyId], references: [id])
  article         String
  nmId            Int?
  barcode         String?
  price           Int?
  wbCreatedAt     DateTime?
  cargoType       Int?
  itemId          String? // SKU портала (по ProductSpec.wbArticle)
  stickerA        String?
  stickerB        String?
  stickerBarcode  String?
  stickerS3Key    String? // PNG стикера 58×40 из API
  canceled        Boolean   @default(false)
  wbStatus        String?
  supplierStatus  String?
  meta            Json? // ответ /orders/meta: какие идентификаторы нужны и что уже заполнено
  lotId           String? // партия ГП, из которой собрано
  czCodeId        String?   @unique
  czCode          CzCode?   @relation(fields: [czCodeId], references: [id])
  kizSentAt       DateTime?
  kizError        String?
  expirationSent  String? // какой срок годности отправлен в WB
  expirationError String?
  updatedAt       DateTime  @updatedAt

  @@index([supplyId])
}

// Загрузка файла ЧЗ на все SKU сразу: коды раскладываются по GTIN
model CzImport {
  id         String    @id @default(uuid())
  fileName   String
  kind       String // pdf | csv
  s3Key      String?
  status     String    @default("processing") // processing | done | error
  pages      Int       @default(0)
  decoded    Int       @default(0)
  result     Json? // { bySku: [{itemId, name, added, duplicates}], unassigned: { gtin: codes[] }, failedPages: [] }
  error      String?
  userId     String
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ─────────────────────────── Отправки Ozon FBS ───────────────────────────

// Отправление Ozon FBS (зеркало /v3/posting/fbs/list) + что сделали у себя
model OzonFbsPosting {
  postingNumber    String    @id // 0186255407-0004-1
  orderNumber      String?
  status           String // awaiting_packaging | awaiting_deliver | delivering | delivered | cancelled …
  substatus        String?
  shipDay          String // день отгрузки по Москве, YYYY-MM-DD
  shipmentDate     DateTime
  inProcessAt      DateTime?
  deliveringAt     DateTime?
  deliveryMethodId String?
  products         Json // [{ offerId, sku, name, qty, price }]
  shipError        String? // ошибка «Собрать» в Ozon
  stockDocId       String? // списание со склада при сборке
  batchNo          Int? // номер группы сборки (для отображения)
  batchId          String? // группа сборки (OzonFbsBatch)
  syncedAt         DateTime  @updatedAt

  @@index([shipDay])
  @@index([batchId])
}

// Квант сборки FBS: отправления на 42 шт., собранные вместе, и их этикетки одним PDF
model OzonFbsBatch {
  id             String     @id @default(uuid())
  day            String // YYYY-MM-DD
  no             Int
  kind           String     @default("quant") // quant — заказы по 1 шт.; multi — по 2+ шт.; manual — выбор вручную; bag — в пакеты
  quantTypeId    String? // тип кванта: товар, штук, короб (короб списывается один на группу)
  quantType      QuantType? @relation(fields: [quantTypeId], references: [id])
  limit          Int? // лимит штук, с которым собирали (null — без лимита)
  postings       Int
  units          Int
  labelS3Key     String?
  labelType      String?
  labelAt        DateTime?
  carriageId     String? // отгрузка (поставка) в Ozon только из отправлений группы
  carriageStatus String?
  carriageAt     DateTime?
  createdAt      DateTime   @default(now())

  @@unique([day, no])
}

// День отгрузки FBS: этикетки и акт
model OzonFbsDay {
  day        String    @id // YYYY-MM-DD
  labelS3Key String?
  labelType  String? // small_label (58×40) | big_label (75×120)
  labelCount Int?
  labelAt    DateTime?
  actId      String?
  actStatus  String?
  actS3Key   String?
  actAt      DateTime?
  lastError  String?
}
