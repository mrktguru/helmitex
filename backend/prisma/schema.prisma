generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  login        String?    @unique
  passwordHash String
  role         Role       @default(OPERATOR)
  createdAt    DateTime   @default(now())
  projects     Project[]
  stockDocs    StockDoc[]
}

enum Role {
  ADMIN
  OPERATOR
}

model Project {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  template      LabelTemplate?
  czBatches     CzBatch[]
  outputBatches OutputBatch[]
}

model LabelTemplate {
  id           String   @id @default(uuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id])
  widthMm      Float
  heightMm     Float
  elements     Json // array of LabelElement objects
  czArea       Json // { xMm, yMm, widthMm, heightMm }
  barcodeValue String?
  printMargins Json? // { topMm, rightMm, bottomMm, leftMm }
  variables    Json? // { [token: string]: string } — current values
  variableDefs Json? // [{ token: string, name: string }] — declared variables
  updatedAt    DateTime @updatedAt
}

model CzBatch {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  s3Key      String
  totalCount Int
  fileHash   String?
  uploadedAt DateTime @default(now())
  codes      CzCode[]

  @@unique([projectId, fileHash])
}

model CzCode {
  id            String       @id @default(uuid())
  czBatchId     String
  czBatch       CzBatch      @relation(fields: [czBatchId], references: [id])
  pageIndex     Int
  code          String?
  status        CodeStatus   @default(PENDING)
  usedAt        DateTime?
  outputBatchId String?
  outputBatch   OutputBatch? @relation(fields: [outputBatchId], references: [id])
}

enum CodeStatus {
  PENDING
  USED
}

model OutputBatch {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  s3Key     String   @default("")
  jobStatus String   @default("pending")
  fromIndex Int
  toIndex   Int
  count     Int
  createdAt DateTime @default(now())
  codes     CzCode[]
}

// ─────────────────────────── Склад ───────────────────────────

enum ItemType {
  RAW // сырьё, кг
  CONTAINER // тара: тубы, банки, вёдра
  PACKAGING // короба
  LABEL // этикетки, наклейки
  SEMI // полуфабрикат (бочки)
  PRODUCT // готовая продукция (SKU)
}

enum ProductState {
  NONE // для всего, кроме ГП
  UNLABELED // расфасовано, без ЧЗ
  LABELED // оклеено ЧЗ, россыпью
}

model Item {
  id          String            @id @default(uuid())
  type        ItemType
  name        String
  unit        String // "кг" | "шт" | "л"
  minStock    Float?
  noStock     Boolean           @default(false) // не учитывается на складе (вода)
  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  lots        Lot[]
  docLines    StockDocLine[]
  recipe      Recipe?           @relation("RecipeOutput")
  recipeLines RecipeLine[]
  outputDocs  StockDoc[]        @relation("DocOutputItem")
  spec        ProductSpec?      @relation("SpecProduct")
  specsAsSemi ProductSpec[]     @relation("SpecSemi")
  materialOf  ProductMaterial[] @relation("MaterialItem")

  @@unique([type, name])
}

model Lot {
  id          String      @id @default(uuid())
  number      String      @unique // С-1007-01, П-1007-01, Г-1007-01
  itemId      String
  item        Item        @relation(fields: [itemId], references: [id])
  supplierLot String?
  expiresAt   DateTime?
  unitCost    Float? // ₽ за единицу учёта, null = не задана
  barrel      String? // номер бочки для полуфабриката
  parentLotId String? // для ГП — бочка, из которой фасовали
  createdAt   DateTime    @default(now())
  moves       StockMove[]

  @@index([itemId])
}

enum DocType {
  RECEIPT // приход
  OPENING // ввод начальных остатков
  ADJUSTMENT // корректировка / инвентаризация
  MIX // замес полуфабриката
  FILL // фасовка
}

enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
}

model StockDoc {
  id        String         @id @default(uuid())
  number    String         @unique
  type      DocType
  status    DocStatus      @default(DRAFT)
  date      DateTime       @default(now())
  supplier  String?
  docRef    String? // УПД № 4417 от 06.10
  comment   String?
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  postedAt  DateTime?
  createdAt DateTime       @default(now())
  lines     StockDocLine[]
  moves     StockMove[]

  // замес: что получаем
  outputItemId String?
  outputItem   Item?     @relation("DocOutputItem", fields: [outputItemId], references: [id])
  outputLotId  String?
  plannedQty   Float?
  yieldQty     Float?
  barrel       String?
  expiresAt    DateTime?
  sourceLotId  String? // фасовка: бочка
  remainQty    Float? // фасовка: остаток в бочке после фасовки (null — бочку не закрывать)
}

model StockDocLine {
  id          String       @id @default(uuid())
  docId       String
  doc         StockDoc     @relation(fields: [docId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item         @relation(fields: [itemId], references: [id])
  lotId       String? // для корректировки — существующий лот; для прихода заполняется при проведении
  qty         Float // для прихода > 0; для корректировки — со знаком
  planQty     Float? // замес: норма по рецептуре (null — корректировка сверх рецептуры)
  stage       Int? // замес: этап
  sort        Int          @default(0)
  unitCost    Float?
  supplierLot String?
  expiresAt   DateTime?
  barrel      String?
  state       ProductState @default(NONE)
  reason      String?
}

model StockMove {
  id        String       @id @default(uuid())
  docId     String
  doc       StockDoc     @relation(fields: [docId], references: [id])
  lotId     String
  lot       Lot          @relation(fields: [lotId], references: [id])
  state     ProductState @default(NONE)
  qty       Float // + приход, − расход
  createdAt DateTime     @default(now())

  @@index([lotId, state])
}

model Recipe {
  id        String       @id @default(uuid())
  itemId    String       @unique
  item      Item         @relation("RecipeOutput", fields: [itemId], references: [id])
  stages    Json? // { "1": "Вода и диспергаторы · мин. обороты, 3 мин", … }
  qc        String? // нормы ОТК текстом
  comment   String?
  updatedAt DateTime     @updatedAt
  lines     RecipeLine[]
}

model RecipeLine {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
  percent  Float
  stage    Int    @default(1)
  sort     Int    @default(0)
}

// Карточка SKU готовой продукции: из чего и как фасуется
model ProductSpec {
  id         String            @id @default(uuid())
  itemId     String            @unique
  item       Item              @relation("SpecProduct", fields: [itemId], references: [id])
  semiItemId String?
  semiItem   Item?             @relation("SpecSemi", fields: [semiItemId], references: [id])
  netQty     Float? // кг полуфабриката в 1 шт
  updatedAt  DateTime          @updatedAt
  materials  ProductMaterial[]
}

model ProductMaterial {
  id         String      @id @default(uuid())
  specId     String
  spec       ProductSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item        @relation("MaterialItem", fields: [itemId], references: [id])
  qtyPerUnit Float       @default(1)
  sort       Int         @default(0)
}
